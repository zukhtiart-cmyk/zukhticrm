# Postgres (Neon or Supabase). On Vercel with Neon these are set automatically; DIRECT_URL is optional.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=""

# Voice desk: speech-to-text (OpenAI) and understanding (Anthropic Claude)
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Photo storage on Vercel (create a Blob store in the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=""

# WhatsApp Business Cloud API (see README → Connecting WhatsApp). Messages are queued while empty.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# Protects the Saturday weekly summary job (Vercel Cron sends it automatically)
CRON_SECRET=""
APP_URL=""
