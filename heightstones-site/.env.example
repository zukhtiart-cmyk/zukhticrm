# Enquiry form email (https://resend.com). Without a key, the form opens the
# visitor's own mail app instead.
RESEND_API_KEY=
# Where enquiries go (comma-separated). Defaults to ramakant@heightstones.com.
ENQUIRY_TO=ramakant@heightstones.com
# Sender: must be on a domain you've verified in Resend.
ENQUIRY_FROM=Height Stones website <website@heightstones.com>
